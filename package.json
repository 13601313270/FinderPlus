{
  "name": "canvas-desk",
  "version": "0.1.0",
  "description": "Finder+ - Electron + Vue3 + Less + TS desktop app",
  "main": "./out/main/index.js",
  "author": "wanghaoran",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-electron-app.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@imgly/background-removal": "^1.7.0",
    "img-compressor-wasm": "^0.1.1",
    "lodash-es": "^4.18.1",
    "onnxruntime-web": "^1.21.0",
    "sql.js": "^1.14.2",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "less": "^4.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
